
extends layout

block content
  h1= title
  p Here are the university search results.

  - let items = results

  div.container-fluid
    div.row
      each university, index in results
        div.col-sm-2
          p Name: #{university.name}
          p Location: #{university.location}
          p Students: #{university.studentCount}
          - let destination = '/universities/update?id=' + university._id
          a.btn.btn-primary.mt-2(href=destination) Update