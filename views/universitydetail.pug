
extends layout

block content
  div.container.py-5
    if !toShow
      div.alert.alert-warning
        h4 University Not Found
        p No university exists with this ID.
        a.btn.btn-secondary(href='/universities') Back to Universities
    else
      div.card.shadow.border-0
        div.card-header.bg-primary.text-white.p-3
          h2.mb-0 University Details

        div.card-body.p-4
          h4.text-primary.mb-4= toShow.name

          p
            strong University ID:
            |  #{toShow._id}

          hr

          p
            strong University Name:
            |  #{toShow.name}

          hr

          p
            strong Location:
            |  #{toShow.location}

          hr

          p
            strong Student Count:
            |  #{toShow.studentCount}

          a.btn.btn-primary.mt-3(href='/universities') Back to Universities
