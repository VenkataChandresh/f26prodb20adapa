extends layout

block content
  h1= title
  p Welcome to my Web Apps Lab 10 application!
  button(type="button", class="btn btn-secondary", onclick="reduce()") Sample Button
  div#use Take some away

  script.
    let current = 11;
    let quantity = 2;

    function reduce() {
      current = current - quantity;

      if (current < 0) {
        current = 0;
      }

      document.getElementById("use").innerHTML =
        `Reduced by ${quantity} to ${current}`;
    }
  a(href="/universities") View University Search Results